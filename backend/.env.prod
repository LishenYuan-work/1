# 生产环境变量（部署时设置，不要提交真实密钥）
# 复制此文件为 .env.prod 并填入真实值

# DeepSeek API
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# LLM 默认
DEFAULT_TEMPERATURE=0.8
DEFAULT_MAX_TOKENS=2048

# 数据库（Supabase PostgreSQL）
# 格式: postgresql+asyncpg://user:pass@host:6543/dbname
DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxxx.supabase.co:6543/postgres

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb-secret-xxx
SUPABASE_ANON_KEY=sb-anon-xxx

# JWT（生产环境务必换成随机字符串）
JWT_SECRET=change-me-to-a-random-64-char-string

# 前端
FRONTEND_URL=https://your-app.vercel.app

# 调试
DEBUG=false
