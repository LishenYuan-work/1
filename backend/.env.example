# DeepSeek API
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# LLM Default
DEFAULT_TEMPERATURE=0.8
DEFAULT_MAX_TOKENS=2048

# Database (SQLite for local dev, PostgreSQL for production)
# Local: sqlite+aiosqlite:///./debate.db
# Production: postgresql+asyncpg://postgres:password@host:6543/postgres
DATABASE_URL=sqlite+aiosqlite:///./debate.db

# JWT (production: use a random 64-char string)
JWT_SECRET=change-me-in-production

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000

# Max concurrent debates
MAX_CONCURRENT_DEBATES=5

# Debug (set to false in production)
DEBUG=true
